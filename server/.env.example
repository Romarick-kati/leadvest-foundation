# Lead Vest Foundation API configuration.
# Copy to server/.env for local development. In production set these in your host's
# environment settings instead. Never commit a real .env file. Placeholders only below.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Example shape only; replace every part.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/lvf_dev

# Browser origin(s) allowed to call the API, comma separated. In production this is the
# Netlify site address, for example https://www.your-domain.example
APP_ORIGIN=http://localhost:5173
# Public site URL used in email links. Defaults to the first APP_ORIGIN.
PUBLIC_APP_URL=

# Two different long random values, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ENCRYPTION_KEY protects stored two factor secrets: changing it later makes every
# enrolled authenticator stop working, so keep it safe and backed up.
SESSION_SECRET=replace_with_a_long_random_value
ENCRYPTION_KEY=replace_with_a_different_long_random_value

# lax is correct when the site proxies /api (the recommended Netlify setup).
COOKIE_SAMESITE=lax
# Number of proxy hops in front of the API, so rate limits see the real client address.
# Netlify proxy plus a platform load balancer is usually 2. Use 0 locally.
TRUST_PROXY=0
# Administrators must turn on two factor authentication before using the dashboard.
REQUIRE_ADMIN_2FA=true
# Header holding the visitor's address when the platform sets one. Empty uses TRUST_PROXY.
CLIENT_IP_HEADER=
# Accept same host origins (only when the API is reachable solely on the site's own domain).
TRUST_SAME_HOST_ORIGIN=false
# Optional: enables the one time /setup page for creating the first administrator without a
# command line. Long random value, 24+ characters. Remove it once the administrator exists.
SETUP_TOKEN=

# Optional Google sign in (OpenID Connect). Leave both empty and the Google buttons explain that Google is not set up yet.
# Create an OAuth client of type "Web application" in Google Cloud Console > APIs & Services >
# Credentials. Authorised redirect URI: <PUBLIC_APP_URL>/api/auth/google/callback
# The client secret is a password: set it only in the host's environment, never in code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the redirect URI must differ from <PUBLIC_APP_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Optional first administrator for `npm run create-admin` (and the Netlify build). Without
# ADMIN_PASSWORD the command prints a one hour setup link instead. Running it again never
# changes an existing administrator. Remove ADMIN_PASSWORD once the account exists.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Email: disabled | console (development only, prints to the log) | smtp
EMAIL_TRANSPORT=console
EMAIL_FROM="Lead Vest Foundation <no-reply@your-domain.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Payments stay disabled until the foundation approves a provider and terms.
# mock is for development and testing only and is refused when NODE_ENV=production.
PAYMENTS_MODE=disabled
PAYMENT_WEBHOOK_SECRET=
# Fapshi mobile money (set PAYMENTS_MODE=fapshi or both). Sandbox keys start with FAK_TEST_.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# The same secret you type into Fapshi's dashboard for webhooks (sent as x-wh-secret).
FAPSHI_WEBHOOK_SECRET=
# What a young person or parent pays before continuing, in FCFA (XAF). 0 = free. Minimum 100.
# Flutterwave: cards from anywhere in the world (set PAYMENTS_MODE=flutterwave, or both to offer Fapshi too).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# The price for card payers abroad in US dollars (0 = they pay the FCFA price).
ACCESS_FEE_USD=0
ACCESS_FEE_XAF=0
# How long one payment lasts, in days (30 = monthly, 365 = yearly, 0 = one payment for good).
ACCESS_PERIOD_DAYS=30
DONATIONS_ENABLED=false

# Where uploaded images are stored: local (UPLOAD_DIR on disk, use a persistent disk in
# production) or netlify-blobs (set automatically on Netlify).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
