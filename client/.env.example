# Lead Vest Foundation frontend. Nothing secret belongs here: every VITE_ value is
# built into public JavaScript that anyone can read.

# Leave empty (recommended). The site calls /api on its own domain, which Netlify proxies
# to the API. Only set this if the API must be called on another domain directly, which
# also needs COOKIE_SAMESITE=none on the server.
VITE_API_BASE_URL=

# Netlify build setting, not a VITE_ value: the API server's https origin, used to write
# the /api proxy rule. Set it in Netlify > Site configuration > Environment variables.
# API_ORIGIN=https://api.your-domain.example

# Optional WhatsApp number for the floating chat button, digits only with the country code
# first (no plus sign or spaces). A number saved in Dashboard > Settings > Contact takes
# priority, so most sites leave this empty. The button stays hidden until one is set.
VITE_WHATSAPP_NUMBER=

# Optional privacy friendly analytics (Plausible compatible). Loaded only after a visitor
# allows analytics in the cookie banner, and never in the learning area or dashboards. Both
# must be set. The script's host must also be added to script-src and connect-src in the
# Content-Security-Policy in netlify.toml. Leave empty for no analytics (the default).
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
